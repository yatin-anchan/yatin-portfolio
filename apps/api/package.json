{
  "name": "@yatin-portfolio/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretypecheck": "npm run build --workspace @yatin-portfolio/database",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prebuild": "npm run build --workspace @yatin-portfolio/database",
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "npm run build && node --env-file=../../.env --test dist/tests/*.test.js",
    "admin:provision": "npm run build && node --env-file=../../.env dist/scripts/provision-admin.js"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@yatin-portfolio/database": "*",
    "@types/cors": "^2.8.19",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "nodemailer": "^10.6.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
